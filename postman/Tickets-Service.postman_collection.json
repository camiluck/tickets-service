    {
      "name": "1. Generar tickets (EFS + subida automatica a S3)",
      "item": [
        {
          "name": "Generar ticket - evento123 / usuarioX (PAGADO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"evento123\",\n  \"eventName\": \"Concierto Rock 2026\",\n  \"eventDate\": \"2026-12-15\",\n  \"venue\": \"Movistar Arena\",\n  \"userId\": \"usuarioX\",\n  \"userName\": \"Juan Perez\",\n  \"userEmail\": \"juan.perez@mail.com\",\n  \"seat\": \"A-10\",\n  \"price\": 35000,\n  \"status\": \"PAGADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set('ticketId', t.id);",
                  "pm.test('Subido a S3', () => pm.expect(t.uploadedToS3).to.be.true);",
                  "console.log('S3 key:', t.s3Key, ' | EFS:', t.efsPath);"
                ]
              }
            }
          ]
